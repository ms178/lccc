vfpclasspsy $123, 4064(%rax), %k2{%k7}
vfpclasspsz $123, 8128(%rax), %k3
vfpclasspdx $123, 2032(%rax), %k4
vfpclasspdy $123, 4064(%rax), %k5{%k7}
vfpclasspdz $123, 8128(%rax), %k6
vfpclassphx $123, 2032(%rax), %k1
vfpclassphy $123, 4064(%rax), %k2
vfpclassphz $123, 8128(%rax), %k3{%k7}
vfpclassbf16x $123, 2032(%rax), %k4
vfpclassbf16y $123, 4064(%rax), %k5{%k7}
vfpclassbf16z $123, 8128(%rax), %k6
vfpclasspsx $123, %xmm3, %k1
vfpclasspdy $123, %ymm4, %k2
vfpclassphz $123, %zmm5, %k3

;;; vfpclass-packed-broadcast-inference-and-tuple-scale
.text
vfpclassps $123, (%rax){1to4}, %k2
vfpclassps $123, 508(%rax){1to8}, %k3{%k7}
vfpclassps $123, -512(%rax){1to16}, %k4
vfpclasspd $123, (%rax){1to2}, %k2
vfpclasspd $123, 1016(%rax){1to4}, %k3{%k7}
vfpclasspd $123, -1024(%rax){1to8}, %k4
vfpclassph $123, (%rax){1to8}, %k2
vfpclassph $123, 254(%rax){1to16}, %k3{%k7}
vfpclassph $123, -256(%rax){1to32}, %k4
vfpclassbf16 $123, (%rax){1to8}, %k2
vfpclassbf16 $123, 254(%rax){1to16}, %k3{%k7}
vfpclassbf16 $123, -256(%rax){1to32}, %k4
vfpclasspsz $123, (%r20), %k5

;;; vfpclass-scalar-tuple1
.text
vfpclassss $123, %xmm6, %k5{%k7}
vfpclassss $123, 508(%rdx), %k5
vfpclassss $123, -512(%rdx), %k5{%k7}
vfpclasssd $123, %xmm6, %k5
vfpclasssd $123, 1016(%rdx), %k5{%k7}
vfpclasssd $123, -1024(%rdx), %k5
vfpclasssh $123, %xmm6, %k5{%k7}
vfpclasssh $123, 254(%rdx), %k5
vfpclasssh $123, -256(%rdx), %k5{%k7}

