vfpclasspd $255, %zmm30, %k0
vfpclassph $123, %xmm6, %k5
vfpclassph $123, %ymm6, %k5
vfpclassph $123, %zmm6, %k5{%k7}
vfpclassbf16 $123, %xmm5, %k5
vfpclassbf16 $123, %ymm5, %k5
vfpclassbf16 $123, %zmm5, %k5{%k7}
vfpclassss $123, %xmm6, %k5
vfpclasssd $255, %xmm30, %k5{%k7}
vfpclasssh $0xab, %xmm6, %k5

;;; vfpclass-x-y-z-pinned-memory
.text
