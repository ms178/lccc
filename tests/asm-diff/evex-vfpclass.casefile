;;; vfpclass-x86_64-registers
.text
vfpclassps $0xab, %xmm1, %k2
vfpclassps $123, %ymm28, %k3{%k7}
vfpclassps $255, %zmm31, %k7
vfpclasspd $-1, %xmm7, %k1{%k2}
