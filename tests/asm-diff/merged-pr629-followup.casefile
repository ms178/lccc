# Merged PR #629 follow-up, isolated GAS 2.47 x86 assembler probes.
# Each group is ONE instruction: an unrelated reject cannot hide a false accept.
# Selector, decorator, GPR-width, APX-extension and xmm EVEX-only controls.
# Generated from independent GAS 2.47 objects; no expected bytes are assumed.

;;; pr629_vex_ccmp reject
.text
{vex} ccmpeq %rcx, %rax
;;; pr629_vex_ctest reject
.text
{vex} ctestne %rcx, %rax
