# What an encoding takes: a register of a kind, a width or a number the
# instruction has no field for is refused, and the statement beside it that
# GNU as assembles is assembled to the same bytes.
#
# The encoders take a register's number and ask no more, and `%xmm3`, `%mm3`,
# `%st(3)`, `%k3`, `%bl`, `%ebx`, `%ds` and `%cr3` are all number three: `rdrand
# %xmm0` was `rdrand %eax`, `movhps %xmm1, %xmm2` was `movlhps`, `vpermd %xmm1,
# %xmm2, %xmm3` an instruction that does not exist at that width. Each `reject`
# group below was assembled; `operand_class::check` and the encoders refuse
# them now. `scripts/gas_table_sweep.py` asks the same of every mnemonic of GNU
# as's table.

;;; operand_kinds_taken
	.text
	seta %cl
	seta %ecx
	seta %rcx
	setzua %cl
	lar %cx, %edx
	lsl %ax, %rcx
	movnti %ecx, (%rdx)
	nop %ax
	nop %ecx
	rdpid %rcx
	pushp %rcx
	popp %r16
	lwpins $0x12345678, %ecx, %rcx
	incsspd %ecx
	rdsspq %rcx
	shl %cl, %eax
	shld %cl, %eax, %edx
	movzbl %cl, %edx
	movswq %cx, %rdx
	crc32b %cl, %eax
	in %dx, %al
	out %eax, %dx
	bswap %ecx
	lea (%rdx), %cx
	movd %eax, %xmm1
	movq %xmm1, %rax
	movq %xmm1, %xmm2
	cvtsd2si %xmm1, %eax
	cvttsd2si (%rdx), %rcx
	vcvtsi2sd %eax, %xmm1, %xmm0
	pextrw $1, %xmm1, %eax
	vpcmpeqd %xmm1, %xmm2, %xmm3
	vpcmpeqd %zmm1, %zmm2, %k3
	vptestmd %zmm1, %zmm2, %k3
	kmovw %eax, %k1
	kmovw %k1, %k2
	movhps (%rdx), %xmm2
	movlps %xmm1, (%rdx)
	movhlps %xmm1, %xmm2
	movlhps %xmm1, %xmm2
	movntdqa (%rdx), %xmm2
	movntq %mm3, (%rdx)
	movntdq %xmm3, (%rdx)
	lddqu (%rdx), %xmm2
	fcomi %st(2), %st
	fcomip %st(2)
	fucomip %st(3), %st
	fcom %st(1)
	vpshufb %ymm1, %ymm2, %ymm3
	vpsllw %xmm1, %ymm2, %ymm3
	vpsllw %xmm1, %zmm2, %zmm3
	vpermd %ymm1, %ymm2, %ymm3
	vpermq $5, %zmm1, %zmm2
	vdppd $5, %xmm1, %xmm2, %xmm3
	vpmovsxbw %xmm1, %ymm2
	vpmovsxbw %ymm1, %zmm2
	vpmovsxbq %xmm1, %zmm2
	vpmovwb %ymm1, %xmm2
	vpmovwb %zmm1, %ymm2
	vcvtps2ph $5, %ymm1, %xmm2
	vcvtps2ph $5, %zmm1, %ymm2
	vcvtps2pd %xmm1, %ymm2
	vcvtpd2ps %ymm1, %xmm2
	vbroadcastss %xmm1, %zmm2
	vinsertf128 $1, %xmm1, %ymm2, %ymm3
	vextractf128 $1, %ymm1, %xmm2
	vinserti32x8 $1, %ymm1, %zmm2, %zmm3
	vextracti32x8 $1, %zmm1, %ymm2
	vmovaps %ymm1, (%rdx)
	vmovaps %xmm17, %xmm18
	vmovaps.s %xmm1, %xmm2
	vgatherdps %ymm1, (%rdx,%ymm7,2), %ymm2
	vcmpeqps %ymm1, %ymm2, %ymm3
	vcmpeqps %zmm1, %zmm2, %k3
	vaddps %zmm1, %zmm2, %zmm3{%k1}{z}
	vaddpd {rn-sae}, %zmm1, %zmm2, %zmm3
	vcvtps2pd {sae}, %ymm1, %zmm2
	vpternlogd $1, (%rdx){1to16}, %zmm1, %zmm2
	vfmaddcph %xmm1, %xmm2, %xmm3
	vmpsadbw $5, %xmm17, %xmm2, %xmm3
	vpcmov %xmm1, %xmm2, %xmm3, %xmm4
	vblendvps %ymm1, %ymm2, %ymm3, %ymm4
	tpause %ecx, %edx, %eax
	umwait %ebx

;;; reject_rdrand_xmm0 reject
	.text
	rdrand %xmm0

;;; reject_adc_cl_mm3 reject
	.text
	adc %cl, %mm3

;;; reject_addps_ecx_xmm1 reject
