# The `.s` (swap/store-direction) suffix across every direction-bit family.
# Every line's expected bytes were GAS 2.47.20260726-probed while wiring
# `s_flip`; asmdiff re-derives both sides per run.
;;; alu_s_reg_reg
.text
add.s %dl,%cl
add.s %dx,%cx
add.s %edx,%ecx
add.s %rdx,%rcx
or.s %edx,%ecx
adc.s %edx,%ecx
sbb.s %edx,%ecx
and.s %edx,%ecx
sub.s %edx,%ecx
xor.s %edx,%ecx
cmp.s %edx,%ecx
sub.s %r8d,%r9d
cmp.s %r9d,%r8d
add.s %r8,%r9
;;; alu_s_suffixed
.text
addb.s %dl,%cl
addw.s %dx,%cx
addl.s %edx,%ecx
addq.s %rdx,%rcx
cmpb.s %dl,%cl
xorq.s %rdx,%rcx
;;; alu_s_ignored_forms
.text
add.s %edx,(%rax)
add.s (%rax),%edx
add.s $5,%edx
subl.s $-1,(%rcx)
or.s $0x7f,%al
;;; test_s
.text
test.s %edx,%ecx
test.s %dl,%cl
test.s %r9d,%r8d
test %edx,%ecx
testb.s %dl,%cl
;;; sse_s_reg_reg
