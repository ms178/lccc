;;; redteam-s02-egpr-base-broadcast-regression
.text
# B4 (APX EGPR base) must not leak into the EVEX map key of the central
# broadcast-count check: every {1toN} row with an r16-r31 base is
# byte-compared against GAS 2.47 (found by the S02 red-team sweep; the
# old check read byte1 & 0xF, folding B4 into mmm).
vaddps 508(%r16){1to16}, %zmm5, %zmm6
vaddps (%r16){1to8}, %ymm5, %ymm6
vaddps 508(%r16,%rax,4){1to16}, %zmm5, %zmm6
vaddps 508(%rax,%r16,4){1to16}, %zmm5, %zmm6
vaddps 1016(%r16){1to8}, %ymm5, %ymm6{%k2}{z}
vfmadd231ps 508(%r16){1to16}, %zmm5, %zmm6{%k3}
vcmpps $1, (%r16){1to16}, %zmm5, %k3
vpshldvd 508(%r16){1to16}, %zmm5, %zmm6{%k3}
vpdpwsud 508(%r17){1to16}, %zmm5, %zmm6
vdpbf16ps 508(%r16){1to4}, %xmm5, %xmm6
vaddps (%r16){1to4}, %xmm5, %xmm6

;;; redteam-s02-egpr-broadcast-reject-count reject
.text
# The B4 fix must not widen acceptance: a wrong count stays rejected.
vaddps 508(%r16){1to8}, %zmm5, %zmm6
vaddps (%r16){1to16}, %xmm5, %xmm6

;;; redteam-s02-sm4-evex-avx10-conformance
.text
# AVX10.2 adds EVEX.128/256/512 rows for SM4 (GAS 2.47 encodes zmm,
# EGPR bases and xmm16+ spellings; low-register xmm/ymm keep VEX).
vsm4key4 %zmm1, %zmm2, %zmm3
vsm4rnds4 %zmm1, %zmm2, %zmm3
vsm4key4 (%r16), %xmm5, %xmm6
vsm4rnds4 %xmm20, %xmm5, %xmm6
vsm4key4 8128(%r16,%r17,8), %zmm2, %zmm3
vsm4key4 2032(%rax), %ymm2, %ymm3
vsm4rnds4 -32(%rax), %ymm5, %ymm6
vsm4key4 -16(%rax), %xmm5, %xmm6

;;; redteam-s02-sm4-reject-width-mismatch reject
.text
vsm4key4 %ymm1, %zmm2, %zmm3

;;; redteam-s02-sm4-reject-mask reject
.text
vsm4key4 %zmm1, %zmm2, %zmm3{%k5}

;;; redteam-s02-sm4-reject-broadcast reject
.text
vsm4key4 (%rax){1to16}, %zmm2, %zmm3

;;; redteam-s02-sm4-reject-sae reject
.text
vsm4rnds4 {sae}, %zmm1, %zmm2, %zmm3

;;; redteam-s02-vfpclass-immediate-and-mask-edges
.text
vfpclassps $0, %xmm1, %k2
vfpclassps $127, %ymm1, %k2
vfpclassps $-128, %zmm1, %k2
vfpclassbf16 $85, %ymm3, %k1{%k3}
# Unsuffixped bf16 rows infer VL from the broadcast count (GAS 2.47):
# {1to16} bf16 = 32 bytes = ymm source.
vfpclassbf16 $123, (%rax){1to16}, %k2

;;; redteam-s02-vfpclass-reject-imm-range-high reject
.text
vfpclassps $256, %xmm1, %k2

;;; redteam-s02-vfpclass-reject-imm-range-low reject
.text
vfpclassps $-129, %xmm1, %k2

;;; redteam-s02-vfpclass-reject-scalar-pinned reject
.text
vfpclassssx $123, %xmm1, %k2

;;; redteam-s02-vfpclass-reject-dest-zeroing reject
.text
vfpclassps $123, %xmm1, %k2{z}

;;; redteam-s02-vfpclass-reject-sae reject
.text
vfpclassps {sae}, $123, %xmm1, %k2

;;; redteam-s02-vfpclass-reject-pinned-broadcast-count reject
.text
vfpclasspsx $123, (%rax){1to8}, %k2

;;; redteam-s02-vcvt-pinned-alias-vex-and-evex
.text
vcvtneps2bf16 %xmm1, %xmm2
vcvtneps2bf16 %ymm1, %xmm2
vcvtneps2bf16y %ymm1, %xmm2
{vex} vcvtneps2bf16 %xmm1, %xmm2
{vex} vcvtneps2bf16 %ymm1, %xmm2
{vex} vcvtneps2bf16y %ymm1, %xmm2
vcvtneps2bf16x (%rax), %xmm2
vcvtneps2bf16y 2032(%rax), %xmm2
vcvtpd2psy %ymm1, %xmm2
vcvtpd2psy 2032(%rax), %xmm2
vcvtqq2psy %ymm1, %xmm2
vcvtneps2bf16y (%rax){1to8}, %xmm2

;;; redteam-s02-vcvt-reject-pinned-broadcast-mismatch reject
.text
vcvtneps2bf16y (%rax){1to16}, %xmm2

;;; redteam-s02-vcvt-reject-vex-zmm reject
.text
{vex} vcvtneps2bf16x %zmm1, %ymm2

;;; redteam-s02-vcvt-reject-pinned-sae reject
.text
vcvtneps2bf16y {rn-sae}, %ymm1, %xmm2

;;; redteam-s02-vcvt-reject-no-z-alias reject
.text
# GAS has no z-pinned alias for the qq2ps row (the zmm->ymm spelling is
# the unsuffixed 512-bit form).
vcvtqq2psz %zmm1, %ymm2

;;; redteam-s02-lane-fp-immediate-and-disp-edges
.text
vinsertf64x2 $0, -2032(%rax), %ymm5, %ymm6{%k7}
vextractf32x4 $255, %zmm5, 2032(%rax){%k7}
vextractf64x4 $1, %zmm5, -4064(%rax){%k7}
vinsertf32x8 $3, -4064(%rax), %zmm5, %zmm6

;;; redteam-s02-lane-fp-reject-imm-range-high reject
.text
vinsertf32x4 $256, %xmm1, %ymm2, %ymm3

;;; redteam-s02-lane-fp-reject-negative-imm reject
.text
# GAS treats the lane selector as unsigned imm8.
vinsertf32x4 $-1, %xmm1, %ymm2, %ymm3

;;; redteam-s02-lane-fp-reject-extract-lane-width reject
.text
vextractf32x8 $1, %zmm5, %xmm6

;;; redteam-s02-lane-fp-reject-insert-xmm-base reject
.text
vinsertf64x4 $1, %ymm1, %ymm2, %ymm3

;;; redteam-s02-compress-expand-byte-word-edges
.text
vpcompressw %ymm3, -254(%rcx){%k2}
vpexpandb -127(%rax), %zmm29{%k2}{z}
vpexpandw 254(%rax), %ymm28
vpcompressb %zmm1, (%r16,%r17,8){%k3}
vpcompressb %zmm30, %zmm31{%k5}{z}

;;; redteam-s02-compress-reject-k0-write-mask reject
.text
# GAS: `%k0' can't be used for write mask — omit the decorator instead.
vpcompressb %xmm1, 127(%rax){%k0}

;;; redteam-s02-compress-reject-mask-on-source reject
.text
# GAS: `mask not on destination operand for `vpexpandw'' — the expand
# load masks the DESTINATION, never the memory source.
vpexpandw (%r16){%k1}, %zmm20

;;; redteam-s02-compress-reject-source-mem reject
.text
vpcompressb 128(%rax), %zmm1

;;; redteam-s02-broadcast-f32x2-edges
.text
vbroadcastf32x2 -1016(%rax), %zmm6{%k3}
vbroadcastf32x2 (%r16), %ymm6
vbroadcastf32x2 %xmm31, %zmm30{%k1}{z}

;;; redteam-s02-broadcast-f32x2-reject-k-on-source reject
.text
vbroadcastf32x2 (%rax){%k2}, %ymm6

;;; redteam-s02-bf16-dot-egpr-and-masking
.text
vdpbf16ps (%r16,%r17,4){1to4}, %xmm5, %xmm6{%k7}
vcvtne2ps2bf16 -508(%rax){1to4}, %xmm5, %xmm6
vcvtne2ps2bf16 (%r16), %zmm4, %zmm6{%k7}{z}

;;; redteam-s02-funnel-shift-egpr
.text
vpshldvw -254(%r16), %zmm5, %zmm6{%k3}
vpshrdvq (%r16,%r17,8), %zmm5, %zmm6
vpshldvd 508(%r16){1to16}, %zmm5, %zmm6{%k3}
