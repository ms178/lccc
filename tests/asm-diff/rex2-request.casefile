;;; rex2_vmovaps_xmm0_xmm1 reject
.text
{rex2} vmovaps %xmm0, %xmm1
;;; rex2_jmp_1f_1 reject
.text
{rex2} jmp 1f
1:
;;; rex2_call_1f_1 reject
.text
{rex2} call 1f
1:
;;; rex2_jmp_rax
.text
{rex2} jmp *%rax
;;; rex2_call_rax
.text
{rex2} call *(%rax)
;;; rex2_loop_1f_1 reject
.text
{rex2} loop 1f
1:
;;; rex2_jrcxz_1f_1 reject
.text
{rex2} jrcxz 1f
1:
