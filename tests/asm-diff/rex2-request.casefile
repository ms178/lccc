# `{rex2}` asks for a REX2 prefix whatever the registers are, one statement a
# group, each held to GNU as 2.47: on an instruction of the legacy maps 0 and
# 1 it is written (`{rex2} nop` is d5 00 90, `{rex2} pause` f3 d5 00 90);
# where no REX2 form exists GNU as refuses the statement (VEX and EVEX
# instructions, the maps 0F 38 and 0F 3A, `xsave`, `in`, `wrmsr`, the
# string instructions, direct jumps and calls); with one
# of %ah %ch %dh %bh, which no instruction behind a REX prefix can name, the
# request is dropped and the statement assembled as written (`{rex2} mov
# %ah, %al` is 88 e0).
#
# Not here, because GNU as 2.47 is wrong about them: `{rex2} mov $5, %dh`
# and the other statements of a number and a high-byte register. GNU as
# writes d5 00 b6 05, which is `mov $5, %sil` (establish_rex in tc-i386.c
# counts its last operand from the wrong end when there is a number, so the
# loop that looks for a high-byte register sees none). lccc drops the
# request there as it does everywhere else; the encoder's unit test
# `rex2_request_with_a_high_byte_register` pins the bytes.
;;; rex2_nop
.text
{rex2} nop
;;; rex2_syscall
.text
{rex2} syscall
;;; rex2_pause
.text
{rex2} pause
;;; rex2_pfadd_mm1_mm2
.text
{rex2} pfadd %mm1, %mm2
;;; rex2_test_5_al
.text
{rex2} test $5, %al
;;; rex2_xbegin_1f_1
.text
{rex2} xbegin 1f
1:
;;; rex2_mov_ah_al
.text
{rex2} mov %ah, %al
;;; rex2_addl_eax_ebx
.text
{rex2} addl %eax, %ebx
;;; rex2_vaddps_xmm1_xmm2_xmm3 reject
.text
{rex2} vaddps %xmm1, %xmm2, %xmm3
;;; rex2_jo_1f_1 reject
.text
{rex2} jo 1f
1:
;;; rex2_clwb_rbx
.text
{rex2} clwb (%rbx)
;;; rex2_xsave_rbx reject
.text
{rex2} xsave (%rbx)
;;; rex2_movabs_0x1122334455667788_rax
.text
{rex2} movabs $0x1122334455667788, %rax
;;; rex2_in_5_al reject
.text
{rex2} in $5, %al
;;; movb_ah_r8b reject
.text
movb %ah, %r8b
;;; movb_ah_sil reject
.text
movb %ah, %sil
;;; movb_ah_bl
.text
movb %ah, %bl
;;; rex2_movzbl_ah_eax
.text
{rex2} movzbl %ah, %eax
;;; rex2_mov_dh_rax
.text
{rex2} mov %dh, (%rax)
;;; rex2_mov_rax_dh
.text
{rex2} mov (%rax), %dh
;;; rex2_inc_dh
.text
{rex2} inc %dh
;;; rex2_shl_cl_dh
.text
{rex2} shl %cl, %dh
;;; rex2_movzbl_dh_eax
.text
{rex2} movzbl %dh, %eax
;;; rex2_mov_dh_r16b reject
.text
{rex2} mov %dh, %r16b
;;; rex2_mov_5_dl
.text
{rex2} mov $5, %dl
;;; rex2_xchg_dh_al
.text
{rex2} xchg %dh, %al
;;; rex2_setc_dh
.text
{rex2} setc %dh
;;; rex2_neg_dh
.text
{rex2} neg %dh
;;; rex2_movl_1_eax
.text
{rex2} movl $1, %eax
;;; rex2_movaps_xmm0_xmm1
.text
