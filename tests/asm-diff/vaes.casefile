;;; vaes_rounds
.text
vaesenc %xmm14, %xmm0, %xmm0
vaesenclast %xmm13, %xmm1, %xmm1
vaesdec %xmm14, %xmm2, %xmm2
vaesdeclast %xmm13, %xmm3, %xmm3
vaesenc %ymm14, %ymm0, %ymm0
vaesdec (%rax), %ymm1, %ymm1
vaesenclast %ymm13, %ymm2, %ymm3
;;; vaes_evex512
.text
vaesenc %zmm14, %zmm0, %zmm0
vaesenc (%rax), %zmm1, %zmm1
vaesenclast %zmm13, %zmm2, %zmm2
vaesdec %zmm14, %zmm3, %zmm3
vaesdeclast %zmm13, %zmm4, %zmm4
vaesenclast (%rsi), %zmm5, %zmm6
;;; vaes_evex_high
.text
vaesenc %ymm17, %ymm21, %ymm23
vaesdec %xmm16, %xmm20, %xmm21
vaesenclast %ymm13, %ymm2, %ymm19
vaesenc %zmm20, %zmm1, %zmm31
;;; vaes_reject reject
.text
vaesenc %zmm0, %zmm1, %zmm2{%k1}
vaesdec %zmm0, %zmm1, %zmm2{%k2}{z}
vaesenc (%rax){1to8}, %zmm1, %zmm2
vaesenclast %ymm3, %ymm4, %ymm5{%k3}
;;; vpshufdq_shifts
.text
vpslldq $4, %zmm1, %zmm1
vpsrldq $8, %zmm9, %zmm9
vpslldq $11, %xmm1, %xmm2
vpsrldq $3, %ymm5, %ymm6
vpslldq $4, (%rax), %zmm1
vpsrldq $5, %zmm20, %zmm21
vpsrldq $1, %ymm17, %ymm18
;;; vpshufdq_shifts_reject reject
.text
vpsrldq $8, %zmm9, %zmm9{%k3}
vpslldq $4, %zmm1, %zmm2{%k1}{z}
vpsrldq $8, (%rax){1to4}, %zmm1
