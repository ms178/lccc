;;; fma-scalar-231-sd
    vfmadd231sd %xmm3, %xmm1, %xmm0
;;; fma-scalar-231-ss
    vfmadd231ss %xmm3, %xmm1, %xmm0
;;; fma-scalar-231-sd-high-regs
    vfmadd231sd %xmm8, %xmm12, %xmm15
;;; fma-scalar-231-ss-high-regs
    vfmadd231ss %xmm9, %xmm14, %xmm2
;;; fma-scalar-213-sd
    vfmadd213sd %xmm2, %xmm1, %xmm0
;;; fma-scalar-132-ss
    vfmadd132ss %xmm1, %xmm2, %xmm0
;;; fms-scalar-231-sd
    vfmsub231sd %xmm3, %xmm1, %xmm0
;;; fnma-scalar-231-ss
    vfnmadd231ss %xmm3, %xmm1, %xmm0
;;; fma-scalar-231-sd-mem
    vfmadd231sd 8(%rdi), %xmm1, %xmm0
;;; fma-scalar-231-ss-mem
    vfmadd231ss (%rsi,%rcx,4), %xmm1, %xmm0
;;; cvtpd2ps-reg
    cvtpd2ps %xmm1, %xmm0
;;; cvtpd2ps-high
    cvtpd2ps %xmm12, %xmm9
;;; cvtpd2ps-mem
    cvtpd2ps (%rdi), %xmm0
