# x86-64 GAS prefix words: addr32/data16/rex/rex.x as standalone spellings.
# GAS 2.47.20260726-probed (`as --64`). addr32 COALESCES with the body's
# address-size override (67 89 00 for `addr32 mov %eax,(%eax)`), redirects
# accumulator-absolute movs to the 32-bit moffs rows, and rejects 64-bit-only
# bases; rex/rex.x OR-merge with the body's REX byte. addr16/data32 and the
# .y/.xy/.z rex spellings do not exist in 64-bit mode.
;;; addr32_forms
.text
addr32 nop
addr32 mov %eax, %ebx
addr32 mov $0x89abcdef, %eax
addr32 mov %eax, (%eax)
addr32 mov (%eax), %eax
addr32 mov %rax, (%ebx)
addr32 push (%eax)
addr32 monitor
addr32 mov %eax, 0x600898
addr32 mov %rax, 0x600898
addr32 mov %ax, 0x600898
addr32 mov %al, 0x600898
addr32 mov 0x600898, %rax
addr32 mov 0x600898, %eax
addr32 rep movsb
addr32 repz cmpsb
addr32 fs mov %eax, (%ebx)
;;; data16_forms
.text
data16 nop
data16 mov %eax, (%eax)
data16 mov %eax, %ebx
;;; data16_branches_near
.text
# The 64-bit data16 branch law (hardware-proven on a Xeon: `66 e9/e8/
# 0f 8x` still consumes a FULL 4-byte displacement — the prefix is
# architecturally dead on near branches in 64-bit mode, per the Intel
# SDM operand-size rules; a 2-byte rel16 field desynchronises the
# decoder and jumps through whatever follows). GAS 2.47 emits the
# truncated `66 e9/e8/0f 8x rel16` for far targets and external
# symbols (R_X86_64_PC16) — bytes that mis-execute on real hardware.
# lccc instead carries the 0x66 as a dead prefix byte on the row the
# un-prefixed branch selects and relaxes exactly like a plain branch:
# NEAR local targets take the SHORT row, byte-identical to GAS
# (`66 eb rel8` / `66 7x rel8`, pinned in this group); far and
# external targets keep `66 e9/e8/0f 8x rel32` + R_X86_64_PLT32 — the
# shortest VALID encoding, a deliberate divergence from GAS's invalid
# bytes (external forms pinned in the encoder unit tests, and every
# row tracked by encdiff over tests/encdiff-corpus/data16-branches-64.insn).
# `data16 call` has no short row and therefore always diverges from
# GAS's truncated form; it lives in the .insn corpus, not here.
data16 jmp 1f
nop
1: nop
data16 je 2f
nop
2: nop
data16 jne 3f
nop
3: nop
;;; data16_branch_rejects reject
.text
data16 jmp foo@PLT
data16 call foo@PLT
;;; rex_forms
.text
rex mov %ebx, %edi
rex.x mov %ebx, %edi
rex mov %r8d, %r9d
rex mov %eax, %ebx
rex.x mov %r8d, %ebx
rex mov %rax, %rbx
rex.x mov %r8d, %r9d
;;; prefix_rejects reject
.text
addr32 addr32 add %eax, (%eax)
addr32 jecxz 1f
addr16 add %rax, (%rax)
data32 mov %eax, %ebx
rex.y mov %ebx, %edi
rex.xy mov %ebx, %edi
rex.z mov %ebx, %edi
rex lock mov %ebx, %edi
data16 mov %ax, (%eax)
addr32 mov %eax, (%rax)
1:
