;;; vcvt-pinned-vex-x-y
.text
vcvtpd2psx %xmm1, %xmm2
vcvtpd2psy %ymm3, %xmm4
vcvtpd2psx (%rax), %xmm5
vcvtpd2psy 4064(%rax), %xmm6
vcvtpd2dqx (%rax), %xmm1
vcvtpd2dqy 1016(%rax), %xmm2
vcvttpd2dqx (%rax), %xmm3
vcvttpd2dqy 1016(%rax), %xmm4

;;; vcvt-pinned-evex-dq-vl
.text
vcvtpd2udqx (%rax), %xmm1
vcvtpd2udqy %ymm2, %xmm3
vcvttpd2udqx 2032(%rax), %xmm4
vcvttpd2udqy %ymm5, %xmm6
vcvtqq2psx (%rax), %xmm1
vcvtqq2psy %ymm2, %xmm3
vcvtuqq2psx (%rax), %xmm4
vcvtuqq2psy %ymm5, %xmm6

;;; vcvt-pinned-fp16-register-and-memory
.text
vcvtdq2phx %xmm1, %xmm2
vcvtdq2phy %ymm3, %xmm4
vcvtudq2phx (%rax), %xmm5
vcvtudq2phy 4064(%rax), %xmm6
vcvtps2phx %xmm1, %xmm2
vcvtps2phxx (%rax), %xmm3
vcvtps2phxy %ymm4, %xmm5
vcvtpd2phx 2032(%rax), %xmm1
vcvtpd2phy 4064(%rax), %xmm2
vcvtpd2phz 8128(%rax), %xmm3
vcvtqq2phx 2032(%rax), %xmm4
vcvtqq2phy 4064(%rax), %xmm5
vcvtqq2phz 8128(%rax), %xmm6
vcvtuqq2phx 2032(%rax), %xmm1
vcvtuqq2phy 4064(%rax), %xmm2
vcvtuqq2phz 8128(%rax), %xmm3
vcvtph2psx %xmm1, %xmm4

;;; vcvt-pinned-bf16-dual-encoding
.text
vcvtneps2bf16 %ymm1, %xmm2
vcvtneps2bf16x (%rax), %xmm3
vcvtneps2bf16y (%rax), %xmm4
{vex} vcvtneps2bf16 %xmm5, %xmm6
{vex} vcvtneps2bf16x %xmm1, %xmm2
{vex} vcvtneps2bf16y (%rax), %xmm3

;;; vcvt-pinned-broadcast-counts
.text
vcvtpd2psx (%rax){1to2}, %xmm1
vcvtpd2psy (%rax){1to4}, %xmm2
vcvtpd2phx (%rax){1to2}, %xmm3
vcvtpd2phy (%rax){1to4}, %xmm4
vcvtpd2phz (%rax){1to8}, %xmm5
vcvtneps2bf16x (%rax){1to4}, %xmm6
vcvtneps2bf16y (%rax){1to8}, %xmm7

;;; vcvt-pinned-evex-forced-on-vex-alias
.text
{evex} vcvtpd2psx (%rax), %xmm1
{evex} vcvtpd2psy (%rax), %xmm2

;;; vcvt-reject-ambiguous-unpinned-narrow-memory reject
.text
vcvtpd2ps (%rax), %xmm2

;;; vcvt-reject-pinned-register-width-mismatch reject
.text
vcvtpd2psx %ymm1, %xmm2

;;; vcvt-reject-pinned-destination-width-mismatch reject
.text
vcvtpd2phz (%rax), %ymm2

;;; vcvt-reject-pinned-broadcast-width-mismatch reject
.text
vcvtpd2phx (%rax){1to4}, %xmm2

;;; vcvt-reject-unsupported-z-spelling reject
.text
vcvtneps2bf16z (%rax), %ymm2

;;; vcvt-reject-false-extra-x-suffix reject
.text
vcvtph2psxx %xmm1, %xmm2
