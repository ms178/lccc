# Segment words, `notrack` and lone prefix words in 32-bit code, one statement
# a group, each held to GNU as 2.47. A segment word is its byte in front of
# any instruction (`cs nop` is 2e 90, `es movsb` is 26 a4), the first of the
# prefixes behind the FWAIT of an x87 instruction; with an operand that names
# the same segment, or the default one, it is the one prefix; with another
# segment it is "same type of prefix used twice". `notrack` is `ds`'s byte in
# front of an indirect near branch, which GCC writes in front of the jump
# through a switch table under -fcf-protection. The i686 encoder had none of
# this: every statement here that GNU as assembles was "unknown prefix".
#
# Not here: a segment word on a direct `call`, which GNU as leaves out with a
# warning and lccc writes, as Clang does.
;;; cs_nop
.text
cs nop
;;; ds_nop
.text
ds nop
;;; es_nop
.text
es nop
;;; ss_nop
.text
ss nop
;;; fs_nop
.text
fs nop
;;; gs_nop
.text
gs nop
;;; cs_mov_eax_ebx
.text
cs mov %eax, (%ebx)
;;; cs_mov_eax_ds_ebx
.text
cs mov %eax, %ds:(%ebx)
;;; cs_mov_eax_ss_ebp
.text
cs mov %eax, %ss:(%ebp)
;;; ss_mov_eax_ebp
.text
ss mov %eax, (%ebp)
;;; ds_mov_eax_ebx
.text
ds mov %eax, (%ebx)
;;; ss_mov_eax_ss_ebx
.text
ss mov %eax, %ss:(%ebx)
;;; cs_mov_eax_cs_ebx
.text
cs mov %eax, %cs:(%ebx)
;;; cs_mov_eax_fs_ebx reject
.text
cs mov %eax, %fs:(%ebx)
;;; fs_mov_eax_fs_ebx
.text
fs mov %eax, %fs:(%ebx)
;;; cs_cs_nop reject
.text
cs cs nop
;;; cs_ds_nop reject
.text
cs ds nop
