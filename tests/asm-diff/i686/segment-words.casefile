es movsb
;;; cs_rep_movsb
.text
cs rep movsb
;;; rep_cs_movsb
.text
rep cs movsb
;;; fs_movsb_ds_esi_es_edi
.text
fs movsb %ds:(%esi), %es:(%edi)
;;; fs_movsb_fs_esi_es_edi
.text
fs movsb %fs:(%esi), %es:(%edi)
;;; cs_movsb_fs_esi_es_edi reject
.text
cs movsb %fs:(%esi), %es:(%edi)
