# The prefix words in 16-bit code (.code16), one statement a group, each held
# to GNU as 2.47. Here the words that do something are `addr32` and `data32`:
# they are the 0x67 and 0x66 bytes, and GNU as refuses `addr16`/`data16` as
# "redundant". `addr32` and a 32-bit address share the one 0x67 (`addr32 movw
# %ax, (%ebx)` is 67 89 03); a 0x67 or 0x66 an instruction has for itself is
# "same type of prefix used twice" (`addr32 jecxz`, `addr32 monitor %eax,
# ...`, `data32 addl %eax, %ebx`). `addr32` sizes the absolute address of a
# bare symbol or number (`addr32 movw %ax, 0x1234` is 67 a3 34 12 00 00) and
# refuses a 16-bit base, and a branch, a far branch and a far return behind
# `data32` take the 32-bit operand. lccc read both words as the 16-bit ones
# of 32-bit code and refused every statement here that GNU as assembles.
;;; addr32_nop
.text
.code16
addr32 nop
;;; data32_nop
.text
.code16
data32 nop
;;; addr16_nop reject
.text
.code16
addr16 nop
;;; data16_nop reject
.text
.code16
data16 nop
;;; data32_addw_ax_bx
.text
.code16
data32 addw %ax, %bx
;;; data32_addl_eax_ebx reject
.text
.code16
data32 addl %eax, %ebx
;;; data16_addw_ax_bx reject
.text
.code16
data16 addw %ax, %bx
;;; data16_addl_eax_ebx reject
.text
.code16
data16 addl %eax, %ebx
;;; addr32_movw_ax_0x1234
.text
.code16
addr32 movw %ax, 0x1234
;;; addr32_movw_ax_bx reject
.text
.code16
addr32 movw %ax, (%bx)
;;; addr32_movw_ax_ebx
.text
.code16
addr32 movw %ax, (%ebx)
;;; addr16_movw_ax_bx reject
.text
.code16
addr16 movw %ax, (%bx)
;;; addr16_movw_ax_ebx reject
.text
.code16
addr16 movw %ax, (%ebx)
