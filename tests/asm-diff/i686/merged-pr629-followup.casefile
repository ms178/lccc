.text
{vex3} vpdpbusd %ymm3, %ymm1, %ymm2
;;; pr629_tuple_xmm_i686 reject
.text
vmovddup (%eax){1to2}, %xmm1
;;; pr629_high_gp_broadcast_32 reject
.text
vpbroadcastb %ah, %xmm1
