# The prefix words in 32-bit code, one statement a group, each held to GNU as
# 2.47. `data16`/`addr16` are the 0x66/0x67 bytes and `data32`/`addr32` are
# refused as "redundant". What lccc had wrong: a branch behind `data16` (the
# displacement is 16 bits when it is not 8: `data16 jmp 1f; 1:` is 66 eb 00,
# and `data16 jmp foo` is 66 e9 with an R_386_PC16), far branches behind
# `data16` (66 ea, a 16-bit offset), `fwait` behind a prefix word (the word
# first: 66 9b; in front of an x87 instruction the 9b goes first), and a bare
# symbol behind `addr16` (16-bit absolute address, R_386_16) in the arms that
# wrote the ModRM bytes themselves (`mov $imm, sym`).
;;; addr16_nop
.text
addr16 nop
;;; data16_nop
.text
data16 nop
;;; addr32_nop reject
.text
addr32 nop
;;; data32_nop reject
.text
data32 nop
;;; data16_addl_eax_ebx
.text
data16 addl %eax, %ebx
;;; data16_addw_ax_bx reject
.text
data16 addw %ax, %bx
;;; addr16_movl_eax_0x1234
.text
addr16 movl %eax, 0x1234
;;; addr16_movl_eax_ebx reject
.text
addr16 movl %eax, (%ebx)
;;; addr16_movl_eax_bx
.text
addr16 movl %eax, (%bx)
;;; data16_ret
.text
data16 ret
;;; data16_lret
.text
data16 lret
;;; data16_push_eax
.text
data16 push %eax
;;; data16_pushl_eax
.text
data16 pushl %eax
;;; data16_pushw_ax reject
.text
data16 pushw %ax
;;; addr16_jecxz_1f_1
.text
addr16 jecxz 1f
1:
;;; addr16_loop_1f_1
.text
addr16 loop 1f
1:
