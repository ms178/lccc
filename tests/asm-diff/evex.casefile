;;; evex_gpr_rm_egpr — GPR r/m >= r16 in EVEX mod=3 uses rex2.B (P0 bit3,
;;; SET, non-inverted) — NOT the vector X bit (P0 bit6 inverted). GAS 2.47
;;; build_apx_evex_prefix/binutils OP_EX; the vector bit mis-encodes %r21
