# encdiff corpus: 64-bit index-only scale-1 addresses folded to base form.
#
# The x86-64 encoder folds `(,%%reg,1)' with an int8-range displacement
# into the plain based form: `-1(,%%rdi,1)' and `-1(%%rdi)' compute the
# same effective address, but the first needs a SIB byte and -- because
# SIB with no base only supports mod=00 + disp32 -- a full 4-byte
# displacement. Moving the index into the base slot drops the SIB byte
# and shrinks the displacement to disp8: 8 bytes become 3-5.
#
# Distilled from the remote-oracle encdiff run over the whole corpus
# (gcc16.2/clang23.1/icx/icc): ICC's encoder performs this fold; GAS
# 2.47, clang, gcc and icx all emit the longer SIB form. lccc now folds
# too, so on this family it matches ICC and beats every other oracle by
# 3-5 bytes per row.
#
# These rows cannot live in tests/asm-diff/*.casefile: the asm-diff
# contract is byte-equality with GNU as, and GAS's bytes here are the
# longer (valid, just not shortest) forms. Run with:
#   scripts/encdiff.py --lccc ./target/fastbuild/lccc \
#       --file tests/encdiff-corpus/index-fold-64.insn
#
# The fold is guarded to: scale==1, no base, integer displacement of
# ANY width (int8 range -> disp8 base form, 3-5 bytes saved; wider
# integers -> mod=10 base form, the SIB byte dropped -- ICC's exact
# encodings, 28 more verified rows). Scale!=1 and symbol displacements
# keep the GAS-parity SIB form; those rows stay in the casefiles.
leaq (,%rcx,1), %rdx
leal (,%rcx,1), %edx
leaq 0(,%rcx,1), %rdx
leal 0(,%rcx,1), %edx
leaq 1(,%rcx,1), %rdx
leal 1(,%rcx,1), %edx
leaq 127(,%rcx,1), %rdx
leal 127(,%rcx,1), %edx
leaq -128(,%rcx,1), %rdx
leal -128(,%rcx,1), %edx
leaq (,%rbx,1), %rdx
leal (,%rbx,1), %edx
leaq 0(,%rbx,1), %rdx
leal 0(,%rbx,1), %edx
leaq 1(,%rbx,1), %rdx
leal 1(,%rbx,1), %edx
leaq 127(,%rbx,1), %rdx
leal 127(,%rbx,1), %edx
leaq -128(,%rbx,1), %rdx
leal -128(,%rbx,1), %edx
leaq (,%r12,1), %rdx
leal (,%r12,1), %edx
leaq 0(,%r12,1), %rdx
leal 0(,%r12,1), %edx
leaq 1(,%r12,1), %rdx
leal 1(,%r12,1), %edx
leaq 127(,%r12,1), %rdx
leal 127(,%r12,1), %edx
leaq -128(,%r12,1), %rdx
leal -128(,%r12,1), %edx
leaq (,%r13,1), %rdx
leal (,%r13,1), %edx
leaq 0(,%r13,1), %rdx
leal 0(,%r13,1), %edx
leaq 1(,%r13,1), %rdx
leal 1(,%r13,1), %edx
leaq 127(,%r13,1), %rdx
leal 127(,%r13,1), %edx
leaq -128(,%r13,1), %rdx
leal -128(,%r13,1), %edx
mov 0(,%rax,1), %rcx
mov 4(,%rax,1), %rcx
mov 127(,%rax,1), %rcx
mov -1(,%rax,1), %rcx
mov 0(,%rcx,1), %rcx
mov 4(,%rcx,1), %rcx
mov 127(,%rcx,1), %rcx
mov -1(,%rcx,1), %rcx
mov 0(,%rdx,1), %rcx
mov 4(,%rdx,1), %rcx
mov 127(,%rdx,1), %rcx
mov -1(,%rdx,1), %rcx
mov 0(,%rbx,1), %rcx
mov 4(,%rbx,1), %rcx
mov 127(,%rbx,1), %rcx
mov -1(,%rbx,1), %rcx
mov 0(,%rbp,1), %rcx
mov 4(,%rbp,1), %rcx
mov 127(,%rbp,1), %rcx
mov -1(,%rbp,1), %rcx
mov 0(,%rsi,1), %rcx
mov 4(,%rsi,1), %rcx
mov 127(,%rsi,1), %rcx
mov -1(,%rsi,1), %rcx
mov 0(,%rdi,1), %rcx
mov 4(,%rdi,1), %rcx
mov 127(,%rdi,1), %rcx
mov -1(,%rdi,1), %rcx
mov 0(,%r8,1), %rcx
mov 4(,%r8,1), %rcx
mov 127(,%r8,1), %rcx
mov -1(,%r8,1), %rcx
mov 0(,%r9,1), %rcx
mov 4(,%r9,1), %rcx
mov 127(,%r9,1), %rcx
mov -1(,%r9,1), %rcx
mov 0(,%r10,1), %rcx
mov 4(,%r10,1), %rcx
mov 127(,%r10,1), %rcx
mov -1(,%r10,1), %rcx
mov 0(,%r11,1), %rcx
mov 4(,%r11,1), %rcx
mov 127(,%r11,1), %rcx
mov -1(,%r11,1), %rcx
mov 0(,%r12,1), %rcx
mov 4(,%r12,1), %rcx
mov 127(,%r12,1), %rcx
mov -1(,%r12,1), %rcx
mov 0(,%r13,1), %rcx
mov 4(,%r13,1), %rcx
mov 127(,%r13,1), %rcx
mov -1(,%r13,1), %rcx
mov 0(,%r14,1), %rcx
mov 4(,%r14,1), %rcx
mov 127(,%r14,1), %rcx
mov -1(,%r14,1), %rcx
mov 0(,%r15,1), %rcx
mov 4(,%r15,1), %rcx
mov 127(,%r15,1), %rcx
mov -1(,%r15,1), %rcx
mov (,%r13,1), %rcx
leaq -1(,%r15,1), %rdx
leaq 128(,%rcx,1), %rdx
leal 128(,%rcx,1), %edx
leaq -129(,%rcx,1), %rdx
leal -129(,%rcx,1), %edx
leaq 65536(,%rcx,1), %rdx
leal 65536(,%rcx,1), %edx
leaq 128(,%rbx,1), %rdx
leal 128(,%rbx,1), %edx
leaq -129(,%rbx,1), %rdx
leal -129(,%rbx,1), %edx
leaq 65536(,%rbx,1), %rdx
leal 65536(,%rbx,1), %edx
leaq 128(,%r12,1), %rdx
leal 128(,%r12,1), %edx
leaq -129(,%r12,1), %rdx
leal -129(,%r12,1), %edx
leaq 65536(,%r12,1), %rdx
leal 65536(,%r12,1), %edx
leaq 128(,%r13,1), %rdx
leal 128(,%r13,1), %edx
leaq -129(,%r13,1), %rdx
leal -129(,%r13,1), %edx
leaq 65536(,%r13,1), %rdx
leal 65536(,%r13,1), %edx
mov 128(,%rax,1), %rcx
mov 2147483647(,%rax,1), %rcx
mov 128(,%rcx,1), %rcx
mov 2147483647(,%rcx,1), %rcx
mov 128(,%rdx,1), %rcx
mov 2147483647(,%rdx,1), %rcx
mov 128(,%rbx,1), %rcx
mov 2147483647(,%rbx,1), %rcx
mov 128(,%rbp,1), %rcx
mov 2147483647(,%rbp,1), %rcx
mov 128(,%rsi,1), %rcx
mov 2147483647(,%rsi,1), %rcx
mov 128(,%rdi,1), %rcx
mov 2147483647(,%rdi,1), %rcx
mov 128(,%r8,1), %rcx
mov 2147483647(,%r8,1), %rcx
mov 128(,%r9,1), %rcx
mov 2147483647(,%r9,1), %rcx
mov 128(,%r10,1), %rcx
mov 2147483647(,%r10,1), %rcx
mov 128(,%r11,1), %rcx
mov 2147483647(,%r11,1), %rcx
mov 128(,%r12,1), %rcx
mov 2147483647(,%r12,1), %rcx
mov 128(,%r13,1), %rcx
mov 2147483647(,%r13,1), %rcx
mov 128(,%r14,1), %rcx
mov 2147483647(,%r14,1), %rcx
mov 128(,%r15,1), %rcx
mov 2147483647(,%r15,1), %rcx

# Segment overrides + the fold: the default-segment class follows the
# FOLDED view (folded_base), so both spellings of one operand encode
# identically. `ss:4(,%%rbp,1)' elides the no-op 0x36 exactly like
# `ss:4(%%rbp)'; `ds:4(,%%rbp,1)' keeps the 0x3e exactly like
# `ds:4(%%rbp)' (an rbp base makes SS the default, so the DS override is
# meaningful text even though 64-bit flat mode ignores the byte).
# `ds:' on a non-SS-default fold stays dropped (`ds:4(,%%rax,1)' ->
# `48 8b 40 04', the 4-byte base form). The 0x36-keep rows for r10
# pin the never-a-default class (index->base=r10, DS default, ss kept).
#
# WHAT THIS GATE VERIFIES per row: the fold itself (ModRM/SIB/disp) and
# the length verdict, on every row; the dead-prefix BYTE (0x26/0x2e/
# 0x36/0x3e) wherever the row is not an rbp/ebp-index fold — the
# explicit-base twins (`ss:4(%%rbp)', `ds:4(%%rbp)', `ds:4(%%rax)'), the
# non-flip folds (`ds:4(,%%rax,1)', `ss:4(,%%rax,1)', the r10 rows) and
# the inline-rendered %%fs/%%gs rows all compare their prefix byte and
# fail the gate if lccc drops or swaps it. The four rbp/ebp-index FLIP
# rows (`ss:4(,%%rbp,1)', `ds:4(,%%rbp,1)', `ss:4(,%%ebp,1)',
# `ds:4(,%%ebp,1)') prove their ADDRESSING-FOLD equivalence and their
# disp economy as verdicts (BEATS over GAS's raw SIB view, round-trip
# verified) but their verdict comparison CANNOT see the dead prefix
# byte: the folded view legitimately differs from GAS's raw bytes by
# exactly that byte, so encdiff's dead-segment law (_ROW_SEG_FOLD)
# deliberately tolerates any ES/DS/SS choice on exactly those rows.
# Since the PR #731 audit (M2 — a dropped 0x3e on the ds flip row still
# classified BEATS through the strip) the prefix byte on ALL FOUR flip
# rows (both halves of the {rbp, ebp} set) is pinned in THIS file via
# `# byte-exact <hex>' annotations, checked before any law or
# round-trip; the Rust twins in encoder mod.rs
# index_fold_tests::fold_decides_segment_elision_on_the_folded_view
# remain the unit-level record of the same bytes (two independent
# guards, one law).
mov %ss:4(,%rbp,1), %rax # byte-exact 488b4504
mov %ss:4(%rbp), %rax
mov %ds:4(,%rbp,1), %rax # byte-exact 3e488b4504
mov %ds:4(%rbp), %rax
mov %ds:4(,%rax,1), %rax
mov %ds:4(%rax), %rax
mov %ss:4(,%rax,1), %rax
mov %fs:4(,%r10,1), %rax
mov %gs:8(,%r11,1), %rax
mov %ss:8(,%r10,1), %rax

# AVX-512 EVEX family (encode_evex_mem + evex_addr_bits fold since the
# S15 red-team): classic ICC folds this family too -- `vmovdqu8
# (,%r10,1),%xmm0' -> `62 d1 7f 08 6f 02' (X->B moved in the EVEX P0
# byte), 6 bytes vs the 11-byte SIB+disp32 every other oracle emits.
# Displacements follow the FVM (N=16) law exactly like GAS's base form:
# non-multiples stay mod=10+disp32, multiples compress to disp8*N, and
# the fold twin encodes byte-identically to the base form. The {evex}
# promoted row rides the same path.
vmovdqu8 (,%r10,1), %xmm0
vmovdqu16 (,%r10,1), %xmm0
vmovdqu32 (,%r10,1), %xmm0
vmovdqu64 (,%r10,1), %xmm0
vmovdqu8 -1(,%r10,1), %xmm0
vmovdqu8 -16(,%r10,1), %xmm0
vmovdqu8 -16(%r10), %xmm0
vmovdqu8 (,%r13,1), %xmm0
vmovdqu8 (,%r12,1), %xmm0
vmovdqu64 64(,%r11,1), %xmm0
{evex} vmovq (,%r10,1), %xmm0
vmovdqu8 16(,%r13,1), %xmm0

# APX x AVX-512 EVEX (the S18 oracle record, completed by the PR #731
# audit follow-up): `gp_id' accepts r16-r31, so the fold fires for EGPR
# indexes exactly like the classic rows -- the extension bit moves X4 ->
# B4 with the slot -- and the fold output is byte-identical to the
# base-form spelling that GAS 2.47 itself accepts and emits. Until S18
# the pins were lccc==lccc twins plus one-time manual probes; until this
# follow-up only 7 of the 10 encoder pins had corpus rows. Now ALL TEN
# mod.rs pins (fold_moves_the_egpr_index_through_avx512_evex) are
# corpus-recorded, and the coverage is a CONTRACT: test_encdiff.py
# refuses a new pin without its corpus row and refuses drift between the
# two records.
#
# What each row proves: the BEATS verdicts prove the addressing-fold
# equivalence (round-trip against GAS's 11-byte SIB+disp32 raw view) and
# the compressed-disp8 economy; the `# byte-exact' annotations prove the
# BYTES — the fold's output must be exactly the base-form spelling
# (byte-identity is this law's correctness argument, and the verdict
# comparison alone cannot see WHICH legal EVEX encoding was chosen). The
# base twins are additionally byte-identical to GAS (ok), pinning the
# same bytes a second way. The (%r20)/(%r24) rows pin the SIB-escape
# base forms (low3=100: modrm 04 + SIB 24 for r20; the r24 twin rides
# B4 into byte1 instead); `16(,%%r16,1)' pins the POSITIVE compressed
# disp8 sign (40 01 = +16xN) next to the shipped -16 (40 ff). A
# UNVERIFIED-BYTES verdict here means the ORACLE PAIR must be fixed,
# never the row deleted (the gate exits 1 on UNVERIFIED-* by design).
vmovdqu8 (,%r16,1), %xmm0 # byte-exact 62f97f086f00
vmovdqu8 (%r16), %xmm0 # byte-exact 62f97f086f00
vmovdqu8 (,%r20,1), %xmm0 # byte-exact 62f97f086f0424
vmovdqu8 (%r20), %xmm0 # byte-exact 62f97f086f0424
vmovdqu8 (,%r24,1), %xmm0 # byte-exact 62d97f086f00
vmovdqu8 (%r24), %xmm0 # byte-exact 62d97f086f00
vmovdqu64 (,%r18,1), %xmm0 # byte-exact 62f9fe086f02
vmovdqu8 -16(,%r16,1), %xmm0 # byte-exact 62f97f086f40ff
vmovdqu8 16(,%r16,1), %xmm0 # byte-exact 62f97f086f4001
{evex} vmovq (,%r16,1), %xmm0 # byte-exact 62f9fd086e00

# The ebp half of the {rbp, ebp} flip set (S18): a 32-bit index in 64-bit
# mode rides the 0x67 addr32 form; the fold moves ebp into the base slot,
# flips the default segment DS -> SS, and the dead-byte law
# (_ROW_SEG_FOLD) unifies lccc's folded view with GAS's raw view on
# exactly these rows -- `ss:4(,%%ebp,1)' elides the 0x36 like `ss:4(%%ebp)'
# (5 bytes, both views agree SS is default post-fold) while GAS's own
# SIB form KEEPS it (raw view: no base, DS default, ss meaningful,
# `36 67 48 8b 04 2d 04 00 00 00', 10 bytes); the ds twins mirror it
# with the 0x3e (fold KEEPS it, 6 bytes -- post-fold SS is default so
# the DS override stays meaningful text -- while GAS's raw view ELIDES
# it, 9 bytes: no base, DS already default).
#
# WHAT THESE FOUR ROWS PROVE, precisely: the BEATS verdicts prove the
# addressing-fold equivalence (lccc's folded base view round-trips
# against GAS's raw SIB view) and the disp8/disp32 economy; the segment
# BYTE is proven by the `# byte-exact' annotations, not by the verdict
# -- the dead-segment canon deliberately tolerates any ES/DS/SS choice
# on exactly these rows (both views are the same 64-bit flat-mode
# program), so the verdict CANNOT see a dropped or swapped prefix
# (PR #731 audit M2: a 3e-less ds fold still classified BEATS). The
# annotations are checked before any law or round-trip, so the corpus
# gate itself goes WRONG-BYTES on a segment-byte regression. The Rust
# twins of all four rows remain the unit-level record:
# index_fold_tests::fold_decides_segment_elision_on_the_folded_view.
mov %ss:4(,%ebp,1), %rax # byte-exact 67488b4504
mov %ss:4(%ebp), %rax # byte-exact 67488b4504
mov %ds:4(,%ebp,1), %rax # byte-exact 3e67488b4504
mov %ds:4(%ebp), %rax # byte-exact 3e67488b4504
