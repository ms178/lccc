# lccc-only: the cell-aliasing constructions contain unsequenced accesses
# (the `*h->p++ = *s++` store and the p-cell update overlap), so GCC may
# legitimately order them differently and is not a valid oracle — under
# GCC's possible ordering the pointer walk is not even contained.  The
# in-process volatile-twin comparison is the verdict; exit 1 on mismatch.
LCCC_NO_COMPARE=1
