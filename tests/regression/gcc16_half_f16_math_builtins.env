# Host glibc 2.39 libm.so.6 does not export *f16 entry points (ceilf16,
# roundevenf16, sqrtf16, fmaf16, nextafterf16, ...), so GCC's libcall lowering
# fails to link at -O2 without -lm or even with glibc 2.39 -lm. LCCC lowers all
# 19 half-float builtins inline with zero libm *f16 symbol dependency.
LCCC_NO_COMPARE=1
