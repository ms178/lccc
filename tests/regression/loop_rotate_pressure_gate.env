# Rotate every loop (RotatePolicy::Always), so the 32-live-out loop in the
# test really is rotated: nothing leaves it, and the default
# (RotatePolicy::Profit) would not touch it. Correctness must hold for the
# rotation itself; the default's decision is pinned by
# tests/regression/check_loop_rotate_profit.sh.
CCC_LOOP_ROTATE=1
