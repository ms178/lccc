# GCC (including GCC 16.2) does not implement Clang's ext_vector_type
# attribute: it warns that the attribute is ignored, then reports scalar
# sizes.  This is a Clang-compatibility regression, so GCC is not a semantic
# oracle for this test.  The dedicated runner still exercises both x86-64 and
# i686 LCCC output directly.
REGRESSION_NO_GCC_COMPARE=1
