# GCC (including 16.2) ignores Clang's ext_vector_type attribute, so the GCC
# build of this fixture would exercise plain scalars; the test is self-checking
# (exit bits) and the cross-compiler legs live in check_gnu_vector_align_abi.sh,
# where GCC compiles the equivalent x87 struct / _Complex long double side.
LCCC_NO_COMPARE=1
