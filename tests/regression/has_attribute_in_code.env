# lccc-only: __has_attribute / __has_builtin expand in ORDINARY CODE position
# (kernel trace.c shape), which is what this test verifies. GCC 14 evaluates
# __has_attribute only inside #if directives; in code position it treats the
# operand as an (implicitly declared) function and the expression folds to 0,
# so the GCC binary fails its own `__has_attribute(noreturn) != 1` check
# ("FAIL noreturn=0"). The GCC reference is not a valid oracle for a feature
# it does not implement; the lccc self-check is the gate.
LCCC_NO_COMPARE=1
