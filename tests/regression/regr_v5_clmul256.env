# lccc-only: _mm256_clmulepi64_epi128 / _mm256_aesenc_epi128 are declared by
# lccc's bundled wmmintrin.h under -mavx2 alone. GCC gates them behind
# __VPCLMULQDQ__ && __AVX512F__ and cannot compile the test without enabling
# AVX-512 (which changes the tested codegen), so it is not a valid oracle.
LCCC_NO_COMPARE=1
