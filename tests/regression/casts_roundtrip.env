# The F128 -> U64 precision-control matrix is deliberately STRICTER than
# GCC: GCC 14.2 -m32 miscompiles 2^64 - 1 under 24/53-bit x87 precision
# control (its subtraction-based conversion returns 0), while lccc's
# native-payload path is exact at every precision-control setting. A
# GCC-compiled oracle binary therefore fails the same checks lccc passes.
LCCC_NO_COMPARE=1
