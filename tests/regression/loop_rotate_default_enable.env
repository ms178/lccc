# v17: loop rotation is now OPT-IN (was v16 default-on). This test
# exercises every shape the rotation pass sees and verifies output is
# bit-identical to GCC. Setting CCC_LOOP_ROTATE=1 here enables the pass
# so the test actually exercises rotation; without it, the pass is a
# no-op and the test still passes (just without rotation coverage).
CCC_LOOP_ROTATE=1
