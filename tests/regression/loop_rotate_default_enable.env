# CCC_LOOP_ROTATE=1 selects RotatePolicy::Always: every loop that can be
# rotated is, early in the pipeline. The default (RotatePolicy::Profit)
# rotates only the loops out of which something then moves, which would
# leave most of the shapes below as they are. This test is about the
# transformation on every shape, so it asks for all of them; the default's
# decision is pinned by tests/regression/check_loop_rotate_profit.sh.
CCC_LOOP_ROTATE=1
