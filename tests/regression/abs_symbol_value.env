# lccc-only: numeric `.set sym, N` top-level symbols must yield their VALUE as
# address (ELF spec). GNU ld rebases absolute-symbol references by the load
# base even for non-PIE executables (returns e.g. 94303056691314 for 7), so
# GCC+ld is a defective oracle; lccc emits the ELF-correct `movq $sym`.
LCCC_NO_COMPARE=1
