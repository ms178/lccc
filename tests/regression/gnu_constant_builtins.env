# GCC 12 classifies a vector type as -1 (`__builtin_classify_type`), while
# GCC 14+ and lccc agree on 19; the fixture pins the newer, standardised
# semantics.  On a host whose GCC predates it the reference binary fails the
# fixture's own assertion, so the comparison is waived *for this test only*
# and reported as SKIP-COMPARE.  A modern oracle still runs the comparison.
LCCC_ORACLE_SELFCHECK=skip
