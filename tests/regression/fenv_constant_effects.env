# GCC 16 does not implement #pragma STDC FENV_ACCESS: it constant-folds
# literal_sum() to the round-to-nearest value and its own self-check exits 1
# under FE_UPWARD. LCCC keeps the runtime add (conformant), so the GCC
# differential is wrong-by-design here. Self-checking exit-code coverage
# across -O0..-Oz and both pragma/flag routes lives in
# tests/regression/check_fp_environment.sh (hosted + local CI).
LCCC_NO_COMPARE=1
