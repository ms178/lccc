# Rust build artifacts
# `/target/` only matches a DIRECTORY. On hosts with a small root disk the
# build directory is moved outside the tree and bridged back with a symlink
# (`ln -s /path/to/target target`) so scripts that hardcode `target/...` keep
# working -- and a symlink is a FILE, so `/target/` does not cover it. Without
# the bare pattern below, `git add -A` commits the symlink and bakes a
# machine-specific path into the repository.
/target/
/target

# Literal @PROFDIR@ dir dropped by PGO tests run outside the x86 driver
# (once polluted a format-patch with .gcda binary blobs)
@PROFDIR@/
/target-sroa/
/target-quest/
**/*.rs.bk

# Crash dumps (root-anchored: a bare `core.*` also matched
# src/backend/*/assembler/encoder/core.rs and made fresh clones
# unable to `git add` the tracked encoder sources)
/core
/core.*

# CCC submodule build
/ccc/target/

# Jekyll build output
/_site/
/.jekyll-cache/
/.sass-cache/
Gemfile.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Compiled / binary
*.o
*.a
*.so
*.dylib
*.exe
a.out
# Root scratch test executables only; source tests in subdirectories are tracked.
/test_*
bench_*
# ...but the benchmark HARNESS is source, not a build artifact. Without this
# negation `bench_*` silently swallows it: tests/bench/ (the kernels and the
# timing driver) shipped upstream while the script that runs them did not,
# leaving a corpus nobody could execute.
!scripts/bench_kernels.py
!scripts/bench_iv_widen_ab.sh
!scripts/bench_rank.py
# Benchmark / test output
/test-results/
/tmp-results/
/tmp/
*.log
*.png
*.pdf
regression-results.json
inline-asm-utf8.json
ci-regression-environment.txt
# bench.yml writes these as job artifacts (`--artifact-dir bench-artifacts`,
# `tee codegen-gate.txt`, `tee bench-terminal.txt`, `--json bench-results.json`,
# `--markdown bench-summary.md`), so a local replication of the bench workflow
# leaves them in the tree. `bench_*` above covers NONE of the three hyphenated
# names: the glob needs an underscore. All three were found untracked by
# `git status` after replicating both workflows, not by reading patterns.
bench-artifacts/
bench-results.json
bench-summary.md
bench-terminal.txt
codegen-gate.txt

# Misc
.tmp
.env
lccc_bench_*
.bench/

# Python bytecode and local Compiler Explorer response cache generated by
# test/oracle scripts.  Oracle evidence belongs under artifacts, not in Git.
__pycache__/
*.py[cod]
/.godbolt-cache/
agentB*.patch
agentB*.txt
/results/
/zlib-ng-validation/
gzip-validation/
zlib-ng-validation/

# Stray stdout-capture from "lccc <in> -o -" test invocations
# (got swept by git add -A in aa1956b and 12eed2b)
/-
.base_ref

# Benchmark assembly dumps. The A/B and oracle scripts emit these into the
# repository root (61 of them, ~21k lines, on 2026-09-30), and the snapshot
# tool's `git add -A -N` swept every one of them into a deliverable patch.
# Generated, machine-specific, and worthless in review: ignore the root-level
# form only, so a checked-in .s under tests/ or tools/ is still tracked.
/*.s

# QEMU TCG plugin API header — GPLv2+ upstream, fetched on demand by
# scripts/qemu_icount_plugin/build.sh; never vendored into this permissive tree.
/scripts/qemu_icount_plugin/qemu-plugin.h
/scripts/qemu_icount_plugin/*.so
ms178-1.patch
tool-results/

# A/B compiler binaries and scratch build outputs (large, machine-specific)
work/

# Generated corpus/document publication locks are synchronization state, not source.
/docs/.edg-changes.lock
/tests/corpus/clang-c/.index.lock
/tests/corpus/.corpus-publish.lock

# Property-based-test runtime artifacts (failing-case dumps).
/pbt-out/
