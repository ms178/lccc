# Rust build artifacts
/target/

# Literal @PROFDIR@ dir dropped by PGO tests run outside the x86 driver
# (once polluted a format-patch with .gcda binary blobs)
@PROFDIR@/
/target-sroa/
**/*.rs.bk

# Crash dumps
core
core.*

# CCC submodule build
/ccc/target/

# Jekyll build output
/_site/
/.jekyll-cache/
/.sass-cache/
Gemfile.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Compiled / binary
*.o
*.a
*.so
*.dylib
*.exe
a.out
test_*
bench_*
# ...but the benchmark HARNESS is source, not a build artifact. Without this
# negation `bench_*` silently swallows it: tests/bench/ (the kernels and the
# timing driver) shipped upstream while the script that runs them did not,
# leaving a corpus nobody could execute.
!scripts/bench_kernels.py
!scripts/bench_iv_widen_ab.sh

# Benchmark / test output
/test-results/
/tmp-results/
/tmp/
*.log
*.png
*.pdf

# Misc
.tmp
.env
lccc_bench_*
.bench/

# Python bytecode and local Compiler Explorer response cache generated by
# test/oracle scripts.  Oracle evidence belongs under artifacts, not in Git.
__pycache__/
*.py[cod]
/.godbolt-cache/
agentB*.patch
agentB*.txt
/results/
/zlib-ng-validation/
gzip-validation/
zlib-ng-validation/

# Stray stdout-capture from "lccc <in> -o -" test invocations
# (got swept by git add -A in aa1956b and 12eed2b)
/-
.base_ref

# QEMU TCG plugin API header — GPLv2+ upstream, fetched on demand by
# scripts/qemu_icount_plugin/build.sh; never vendored into this permissive tree.
/scripts/qemu_icount_plugin/qemu-plugin.h
/scripts/qemu_icount_plugin/*.so
ms178-1.patch
