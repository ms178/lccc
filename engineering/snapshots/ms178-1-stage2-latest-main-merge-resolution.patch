+        // instruction is emitted.
+        let imm = match int_const_bits(acc) {
+            Some(a) => {
+                // Only a plan whose product is a single instruction leaves
+                // room for the immediate.
+                if !matches!(
+                    plan,
+                    MulPlan::AddShifted { m: 0, .. } | MulPlan::SubShifted { m: 0, .. }
+                ) {
