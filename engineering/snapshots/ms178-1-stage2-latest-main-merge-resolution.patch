+                    }
+                }
+                // t = -(2^k - 1)x, so a + c*x = a - t.
+                MulPlan::ShiftedMinus { .. } => {
+                    self.state.emit_fmt(format_args!("    sub {d}, {a}, {t}"));
+                }
+            },
+        }
+        if dest_phys.is_some() {
+            self.state.reg_cache.invalidate_acc();
+        } else {
+            self.store_x0_to(dest);
+        }
+        true
+    }
