+            LineKind::Nop => continue,
+            LineKind::Directive if inert_directive(&lines[c]) => continue,
+            LineKind::CondBranch => return Some(c),
+            LineKind::Label
+            | LineKind::Branch
+            | LineKind::CmpBranch
+            | LineKind::Call
+            | LineKind::Ret
+            | LineKind::Directive => return None,
+            _ => {}
+        }
+        if flag_operands(&lines[c], kinds[c]) != (0, 0) {
+            return Some(c);
+        }
+        seen += 1;
+        if seen > 8 {
+            return None;
+        }
+    }
+    None
