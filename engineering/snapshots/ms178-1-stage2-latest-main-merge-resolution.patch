+///   signed `x > 0`, which is the single `slt t0, zero, t1`, and unsigned
+///   `x > 0`/`x <= 0`, which are `snez`/`seqz`.
+pub(super) fn imm_cmp_form(op: IrCmpOp, v: i64) -> Option<ImmCmp> {
