+            } else if matches!(part, "fp" | "gp" | "tp")
+                || (part.len() > 1
+                    && part.starts_with('x')
+                    && part[1..].bytes().all(|b| b.is_ascii_digit()))
+            {
+                unmodelled = true;
+            }
+        }
+    }
+    (mask, unmodelled)
