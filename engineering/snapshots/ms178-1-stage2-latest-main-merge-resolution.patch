+    let mut changed = false;
+    for (start, end) in rv_function_ranges(lines, kinds, n) {
+        if let Some(frame) = rv_vestigial_frame(lines, kinds, start, end) {
+            for k in frame {
+                kinds[k] = LineKind::Nop;
             }
+            changed = true;
         }
     }
     changed
