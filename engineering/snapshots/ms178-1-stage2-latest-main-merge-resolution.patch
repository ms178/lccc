+        match op {
+            IrCmpOp::Eq => a == b,
+            IrCmpOp::Ne => a != b,
+            IrCmpOp::Slt => a < b,
+            IrCmpOp::Sle => a <= b,
+            IrCmpOp::Sgt => a > b,
+            IrCmpOp::Sge => a >= b,
