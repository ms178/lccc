+        };
+        let mut materialize = |this: &mut Self, op: &Operand, scratch: &'static str| -> String {
+            if let Some(reg) = this.operand_reg(op).filter(|r| !is_arm_fp_phys(*r)) {
+                return name(reg).to_string();
