+    fn tiny_readonly_reduction_profitability_refusals() {
+        let func = make_two_block_feed_loop(64, LatchFeed::LoadOnly);
+        let phis = collect_header_phis(&func, 1, BlockId(2)).unwrap();
+        let work = &func.blocks[2].instructions[..4];
+        assert!(tiny_readonly_reduction(work, &phis, Value(1), 64));
+        assert!(!tiny_readonly_reduction(work, &phis, Value(1), 31));
+        let mut changed = work.to_vec();
+        if let Instruction::Load { ptr, .. } = &mut changed[2] {
+            *ptr = Value(2);
+        }
+        assert!(!tiny_readonly_reduction(&changed, &phis, Value(1), 64));
+        changed = work.to_vec();
+        if let Instruction::Load { volatile, .. } = &mut changed[2] {
+            *volatile = true;
+        }
+        assert!(!tiny_readonly_reduction(&changed, &phis, Value(1), 64));
+        changed = work.to_vec();
+        changed.push(changed[2].clone());
+        assert!(!tiny_readonly_reduction(&changed, &phis, Value(1), 64));
+        changed = work.to_vec();
+        if let Instruction::BinOp { op, .. } = &mut changed[3] {
+            *op = IrBinOp::Xor;
+        }
+        assert!(!tiny_readonly_reduction(&changed, &phis, Value(1), 64));
+        while changed.len() <= 10 {
+            changed.push(work[0].clone());
+        }
+        assert!(!tiny_readonly_reduction(&changed, &phis, Value(1), 64));
+    }
