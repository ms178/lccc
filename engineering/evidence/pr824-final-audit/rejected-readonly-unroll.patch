 /// Returns `true` when the loop was rewritten.
+/// A deliberately small read-only exception to the store-seeded SLP policy.
+/// One independent integer load feeds one 32-bit Add accumulator. Table
+/// walks indexed by the accumulator (CRC), FP, calls, volatile accesses and
+/// large/live-state bodies are excluded. Existing finite-trip/CFG/clone
+/// proofs still apply; only profitability admission changes.
+fn tiny_readonly_reduction(work: &[Instruction], phis: &[HeaderPhi], iv: Value, trip: i64) -> bool {
+    if trip < 32 || work.len() > 10 || phis.len() != 2 {
+        return false;
+    }
+    let Some(acc) = phis.iter().find(|p| p.id != iv.0) else {
+        return false;
+    };
+    if !acc.ty.is_integer() || acc.ty.size() != 4 {
+        return false;
+    }
+    let Operand::Value(back) = acc.back else {
+        return false;
+    };
+    let mut loads = 0;
+    let mut sum = false;
+    for inst in work {
+        if let Instruction::BinOp {
+            dest,
+            op: IrBinOp::Add,
+            lhs,
+            rhs,
+            ty,
+        } = inst
+            && *dest == back
+            && *ty == acc.ty
+            && (matches!(lhs, Operand::Value(v) if v.0 == acc.id)
+                != matches!(rhs, Operand::Value(v) if v.0 == acc.id))
+        {
+            sum = true;
+            continue;
+        }
+        let mut consumes_acc = false;
+        inst.for_each_used_value(|v| consumes_acc |= v == acc.id);
+        if consumes_acc {
+            return false;
+        }
+        match inst {
+            Instruction::Load {
+                ty,
+                volatile: false,
+                ..
+            } if ty.is_integer() && ty.size() == 4 => loads += 1,
+            Instruction::GlobalAddr { .. }
+            | Instruction::GetElementPtr { .. }
+            | Instruction::Copy { .. } => {}
+            Instruction::Cast { from_ty, to_ty, .. }
+                if from_ty.is_integer() && to_ty.is_integer() => {}
+            Instruction::BinOp { op, ty, .. }
+                if ty.is_integer()
+                    && matches!(
+                        op,
+                        IrBinOp::Add
+                            | IrBinOp::Sub
+                            | IrBinOp::Mul
+                            | IrBinOp::And
+                            | IrBinOp::Or
+                            | IrBinOp::Xor
+                            | IrBinOp::Shl
+                            | IrBinOp::LShr
+                            | IrBinOp::AShr
+                    ) => {}
+            _ => return false,
+        }
+    }
+    sum && loads == 1
+}
