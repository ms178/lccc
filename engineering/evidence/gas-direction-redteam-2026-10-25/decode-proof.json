 "exempt": {
  "fcom 0xdc": "dc /2 is `FCOM m64fp`, a memory-only form; GAS's reverse match still produces the register shape",
  "mov 0x24": "0f 24 is `mov` to/from an obsolete TR register; objdump does not decode TR at all",
  "mov 0x26": "0f 26 is the reverse of 0f 24 (see above)",
  "movq 0x6e": "the row is the REX.W form of `66 0f 6e`, which is `movd` without REX.W; the table does not record the W bit and objdump correctly names the spelling it sees",
  "movq 0x7e": "the reverse of the `movq` 0f 6e row (see above)",
  "pop 0x07": "07 is `pop %es`, which does not exist in 64-bit mode",
  "push 0x06": "06 is `push %es`, which does not exist in 64-bit mode (the row is No64)",
  "xchg 0x90": "90 is spelled `nop` by every disassembler"
