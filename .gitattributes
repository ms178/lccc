# Normalize line endings to LF on commit
* text=auto eol=lf

# Source code
*.rs      text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.py      text eol=lf
*.sh      text eol=lf

# Web / markup
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.json    text eol=lf

# Config
.gitignore      text eol=lf
.gitattributes  text eol=lf
Makefile        text eol=lf

# Binary — never diff or touch line endings
# Compressed evidence archives: `* text=auto` must never normalize a byte
# stream whose SHA-256 is pinned by the evidence inventories.
*.gz     binary
*.xz     binary
*.zip    binary
*.tar    binary
*.bz2    binary
*.zst    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary

# Historical instrumentation is byte evidence, not formatted source. Preserve
# Valgrind's trailing spaces and captured terminal blank lines verbatim.
engineering/evidence/2026-10-14-auipc-range/**/*.txt whitespace=-blank-at-eol,-blank-at-eof
